# Supabase (database + auth)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Air Quality
EXPO_PUBLIC_GOOGLE_AIR_QUALITY_KEY=

# Cloudflare R2 — public read URL (safe in client bundle)
EXPO_PUBLIC_R2_ACCOUNT_ID=
EXPO_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Cloudflare R2 — write credentials. SERVER-SIDE ONLY.
# Never reference these from the client app. Only the seed script
# (scripts/seed.ts) and future Supabase Edge Functions read them.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Supabase service role key — SERVER-SIDE ONLY, used by the seed script
# to bypass RLS for initial data loading.
SUPABASE_SERVICE_ROLE_KEY=
